DRIVER_DASHBOARD_PASSWORD=change-this-password
DRIVER_SESSION_SECRET=change-this-long-random-string

# Google Maps JS API — used if a route map is shown in the browser.
# Restrict it by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API (server-side only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRIVER_NUMBER=34631555171
WHATSAPP_API_VERSION=v21.0

# ── Supabase (required for admin dashboard + dynamic driver) ────
# Get these from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
